<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeLoginFragment">

    <!-- 1. Layar Pertama: home_login.xml -->
    <fragment
        android:id="@+id/homeLoginFragment"
        android:name="com.example.mobileadvapp.ui.HomeLoginFragment"
        android:label="Home Login"
        tools:layout="@layout/home_login">
        <!-- Aksi menuju ke form fragment_login.xml -->
        <action
            android:id="@+id/action_homeLoginFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <!-- Aksi Auto-Login menuju ke Main/Home Screen -->
        <action
            android:id="@+id/action_homeLoginFragment_to_homeScreen"
            app:destination="@id/homeScreen"
            app:popUpTo="@id/homeLoginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- 2. Layar Kedua: fragment_login.xml (Form Login) -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.mobileadvapp.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <!-- Aksi menuju ke home_screen.xml -->
        <action
            android:id="@+id/action_loginFragment_to_homeScreen"
            app:destination="@id/homeScreen"
            app:popUpTo="@id/homeLoginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- 3. Layar Ketiga: home_screen.xml (Home Screen Utama) -->
    <fragment
        android:id="@+id/homeScreen"
        android:name="com.example.mobileadvapp.ui.HomeScreen"
        android:label="Home Screen"
        tools:layout="@layout/home_screen">
        <action
            android:id="@+id/action_homeScreen_to_categoryFragment"
            app:destination="@id/categoryFragment" />
        <action
            android:id="@+id/action_homeScreen_to_themeSettingFragment"
            app:destination="@id/themeSettingFragment" />
        <action
            android:id="@+id/action_homeScreen_to_homeLoginFragment"
            app:destination="@id/homeLoginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- 4. Layar Pengaturan Tema -->
    <fragment
        android:id="@+id/themeSettingFragment"
        android:name="com.example.mobileadvapp.ui.ThemeSettingFragment"
        android:label="Pengaturan Tampilan"
        tools:layout="@layout/fragment_theme_setting" />

    <!-- Fragment Tambahan -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.mobileadvapp.ui.HomeFragment"
        android:label="Home Fragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.mobileadvapp.ui.DetailFragment"
        android:label="Detail Fragment"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="username"
            app:argType="string"
            android:defaultValue="Guest" />
        <argument
            android:name="userScore"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/categoryFragment"
        android:name="com.example.mobileadvapp.ui.CategoryFragment"
        android:label="Kategori"
        tools:layout="@layout/fragment_category">
        <action
            android:id="@+id/action_categoryFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.example.mobileadvapp.ui.ProductDetailFragment"
        android:label="Detail Produk"
        tools:layout="@layout/fragment_product_detail">
        <action
            android:id="@+id/action_productDetailFragment_to_cartFragment"
            app:destination="@id/cartFragment" />
    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.example.mobileadvapp.ui.CartFragment"
        android:label="Keranjang"
        tools:layout="@layout/fragment_cart">

        <argument
            android:name="productName"
            app:argType="string" />
        <argument
            android:name="quantity"
            app:argType="integer"
            android:defaultValue="1" />

        <action
            android:id="@+id/action_cartFragment_to_categoryFragment"
            app:destination="@id/categoryFragment"
            app:popUpTo="@id/categoryFragment"
            app:popUpToInclusive="false" />
    </fragment>
</navigation>