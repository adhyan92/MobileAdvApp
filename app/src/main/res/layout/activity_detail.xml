        android:clipToPadding="false"
        android:fillViewport="true"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#33000000"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Detail Data Mahasiswa"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:shrinkColumns="2"
                        android:stretchColumns="2">

                        <TableRow android:paddingVertical="8dp">
                            <TextView android:text="Nama" android:textSize="15sp" />
                            <TextView
                                android:paddingStart="22dp"
                                android:paddingEnd="8dp"
                                android:text=":"
                                android:textSize="15sp" />
                            <TextView
                                android:id="@+id/tvNama"
                                android:textSize="15sp" />
                        </TableRow>

                        <TableRow android:paddingVertical="8dp">
                            <TextView android:text="NIM" android:textSize="15sp" />
                            <TextView
                                android:paddingStart="22dp"
                                android:paddingEnd="8dp"
                                android:text=":"
                                android:textSize="15sp" />
                            <TextView
                                android:id="@+id/tvNim"
                                android:textSize="15sp" />
                        </TableRow>

                        <TableRow android:paddingVertical="8dp">
                            <TextView android:text="Program Studi" android:textSize="15sp" />
                            <TextView
                                android:paddingStart="22dp"
                                android:paddingEnd="8dp"
                                android:text=":"
                                android:textSize="15sp" />
                            <TextView
                                android:id="@+id/tvProdi"
                                android:textSize="15sp" />
                        </TableRow>

                        <TableRow android:paddingVertical="8dp">
                            <TextView android:text="Skor" android:textSize="15sp" />
                            <TextView
                                android:paddingStart="22dp"
                                android:paddingEnd="8dp"
                                android:text=":"
                                android:textSize="15sp" />
                            <TextView
                                android:id="@+id/tvSkor"
                                android:textSize="15sp" />
                        </TableRow>
                    </TableLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#33000000"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Informasi Kampus"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCallCenter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Call Center Kampus" />

                    <Button
                        android:id="@+id/btnLokasi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lokasi Kampus" />

                    <Button
                        android:id="@+id/btnWebsite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Website Kampus" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Logo Universitas Amikom Yogyakarta"
                    android:src="@drawable/logo_amikom" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Universitas Amikom Yogyakarta"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
